# Server
PORT=3000
NODE_ENV=development

# MongoDB URI (Update for production / MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/reroute

# Session Secret (Replace with a strong random secret in production)
SESSION_SECRET=reroute_dev_secret_change_in_prod

# Campus / Home IP Whitelist (comma-separated CIDR ranges or IPs)
ALLOWED_IPS=127.0.0.1,::1,192.168.100.0/24,192.168.1.0/24,192.168.0.0/16

# Frontend origins (CORS)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://192.168.100.14:5173,http://192.168.100.14:5174
