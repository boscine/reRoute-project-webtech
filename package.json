{
  "name": "reroute",
  "version": "1.0.0",
  "description": "ReRoute Campus Network Admin Platform — Vue 3 (Auth) + React (Dashboard) + Express/MongoDB (Backend)",
  "private": true,
  "workspaces": [
    "backend",
    "frontend/*"
  ],
  "scripts": {
    "auth": "npm run dev --workspace=frontend/auth",
    "dashboard": "npm run dev --workspace=frontend/dashboard",
    "backend": "npm run dev --workspace=backend",
    "seed": "npm run seed --workspace=backend",
    "dev": "concurrently \"npm run backend\" \"npm run auth\" \"npm run dashboard\"",
    "build:auth": "npm run build --workspace=frontend/auth",
    "build:dashboard": "npm run build --workspace=frontend/dashboard",
    "build": "npm run build:auth && npm run build:dashboard",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.1.2"
  }
}
