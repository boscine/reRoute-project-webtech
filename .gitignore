# Dependencies
node_modules/
*/node_modules/

# Nested lockfiles - this is an npm workspaces monorepo, so only the single
# root package-lock.json is tracked. Anchored so the root file stays visible.
/backend/package-lock.json
/frontend/*/package-lock.json

# Production builds
dist/
*/dist/
dist-ssr/
*/dist-ssr/

# Environment variables & secrets
.env
.env.*
!.env.example
*/.env
*/.env.*
!*/.env.example

# Test artifacts
playwright-report/
test-results/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor & OS files
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
